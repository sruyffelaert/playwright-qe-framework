# Copy this file to .env and replace the placeholders below.
# Playwright's existing dotenv configuration loads .env; keep that file out of Git.

# Selects .env.<env>, environment JSON, and Vault folder: DEV, SIT, or UAT.
# BASE_URL belongs in .env.dev, .env.sit, or .env.uat, not in this shared file.
TEST_ENV=DEV

# Vault server address, without /v1. This is qe-vault-local's default address.
VAULT_ADDR=http://127.0.0.1:8200

# Application team's Vault Userpass login (not the application's login account).
# Replace these placeholders with the team username and secret-zero password.
# For qe-vault-local, VAULT_PASSWORD uses that project's QE_VAULT_PASSWORD value.
VAULT_USERNAME=your-team-vault-username
VAULT_PASSWORD=replace-with-your-vault-userpass-password

# The application login email and password belong in Vault, not in this file:
# secret/dev/test-account, secret/sit/test-account, or secret/uat/test-account.
# Secret fields: username = application login email; password = application password.
# The environment JSON account's vaultSecret field selects the secret name.
# Userpass must be mounted at auth/userpass and KV v2 at secret.
# Vault tokens are obtained at runtime and cached in memory; no token setting is needed.

# Optional standalone demonstration: set to 1 to enable vault-integration-demo.spec.ts.
# The login/logout test always requests Vault, regardless of this flag.
RUN_VAULT_DEMO=0
